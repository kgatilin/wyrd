{{- /*
Example tier-1 codegen template: kind constants plus the mechanical surface
derived from one component's declaration.

Copy this into your project's .arch/templates/ and edit it. wyrd never learns
your types; everything below is chosen here, not by wyrd.

Everything it emits is self-contained — no project types are referenced — so a
generated file compiles on its own. Tier 2 (a subject address book) and tier 3
(payload structs) are where a project's own types enter, and that belongs in
the project's copy of this template.

Package name comes from `extra.go_package` when the declaration sets it,
otherwise from the component id. `index` is used rather than `.Extra.go_package`
because templates run with missingkey=error: `index` on an absent key yields an
empty value instead of failing, which is the presence test.
*/ -}}
{{- $pkg := unexported .Component -}}
{{- if .Extra }}{{ with index .Extra "go_package" }}{{ $pkg = . }}{{ end }}{{ end -}}
// Code generated by wyrd plugin events gen. DO NOT EDIT.
//
// Component: {{ .Component }}
{{- if .Owns }}
// Owns:      {{ .Owns }}
{{- end }}
{{- if .Description }}
//
{{ docComment .Description }}
{{- end }}

package {{ $pkg }}

// Event kinds declared by this component. The constant is a Go name; the value
// is the wire name and is reproduced exactly as declared — a durable log is not
// refactorable.
const (
{{- range .Kinds }}
	Kind{{ goIdent . }} = {{ quote . }}
{{- end }}
)

// Outputs lists every kind this component appends to the log.
var Outputs = []string{
{{- range .Outputs }}
	Kind{{ goIdent .Kind }},
{{- end }}
}

// Inputs lists every kind that triggers this component.
var Inputs = []string{
{{- range .Inputs }}
	Kind{{ goIdent .Kind }},
{{- end }}
}

// StateEvents lists every kind this component folds into its state without
// being triggered by it. They may be its own outputs or another component's.
var StateEvents = []string{
{{- range .StateEvents }}
	Kind{{ goIdent .Kind }},
{{- end }}
}
{{ if or .ForeignOutputs .ForeignInputs .ForeignStateEvents }}
// Foreign kinds cross this component's namespace boundary: they are defined by
// somebody else's declaration, so their schemas are not this package's to change.
var Foreign = []string{
{{- range .ForeignOutputs }}
	Kind{{ goIdent .Kind }}, // output
{{- end }}
{{- range .ForeignInputs }}
	Kind{{ goIdent .Kind }}, // input
{{- end }}
{{- range .ForeignStateEvents }}
	Kind{{ goIdent .Kind }}, // state event
{{- end }}
}
{{ end }}
{{- $exclusive := false }}{{ range .Outputs }}{{ if .Exclusive }}{{ $exclusive = true }}{{ end }}{{ end }}
{{- range .Inputs }}{{ if .Exclusive }}{{ $exclusive = true }}{{ end }}{{ end }}
{{- if $exclusive }}
// Exclusive kinds opted out of broadcast: exactly one component handles them.
var Exclusive = []string{
{{- range .Outputs }}{{ if .Exclusive }}
	Kind{{ goIdent .Kind }},
{{- end }}{{ end }}
{{- range .Inputs }}{{ if .Exclusive }}
	Kind{{ goIdent .Kind }},
{{- end }}{{ end }}
}
{{ end }}
{{- if .Fold.Subjects }}
// The fold read-set is derived from inputs plus state events — nothing
// declares it{{ if .Fold.PartitionKey }}, and it holds one state per ({{ join .Fold.PartitionKey ", " }}){{ end }}.
var (
	FoldSubjects = []string{
	{{- range .Fold.Subjects }}
		{{ quote . }},
	{{- end }}
	}
	FoldPartitionKey = []string{
	{{- range .Fold.PartitionKey }}
		{{ quote . }},
	{{- end }}
	}
	FoldConsumes = []string{
	{{- range .Fold.Consumes }}
		{{ quote . }},
	{{- end }}
	}
)
{{ end }}
{{- if .Fold.State }}
// FoldStateSchema is the declared projection state, as JSON Schema.
const FoldStateSchema = {{ quote (jsonRaw .Fold.State) }}
{{ end }}
{{- range .Outputs }}{{ if .Pattern }}
// Subject{{ goIdent .Kind }} is the address {{ .Kind }} travels on.
const Subject{{ goIdent .Kind }} = {{ quote .Pattern }}
{{ end }}{{ end }}
{{- range .Outputs }}{{ if .Schema }}
// PayloadSchema{{ goIdent .Kind }} is the declared wire schema for {{ .Kind }}.
const PayloadSchema{{ goIdent .Kind }} = {{ quote (jsonRaw .Schema) }}
{{ end }}{{ end }}
{{- range .Types }}
// TypeSchema{{ goIdent .Name }} is the reusable definition {{ .Name }}.
const TypeSchema{{ goIdent .Name }} = {{ quote (jsonRaw .Schema) }}
{{ end }}
