{{- /*
Example tier-1 codegen template: kind constants plus the mechanical surface
derived from one component's declaration.

Copy this into your project's .arch/templates/ and edit it. archai never learns
your types; everything below is chosen here, not by archai.

Everything it emits is self-contained — no project types are referenced — so a
generated file compiles on its own. Tier 2 (a subject address book) and tier 3
(payload structs) are where a project's own types enter, and that belongs in
the project's copy of this template.

Package name comes from `extra.go_package` when the declaration sets it,
otherwise from the component id. `index` is used rather than `.Extra.go_package`
because templates run with missingkey=error: `index` on an absent key yields an
empty value instead of failing, which is the presence test.
*/ -}}
{{- $pkg := unexported .Component -}}
{{- if .Extra }}{{ with index .Extra "go_package" }}{{ $pkg = . }}{{ end }}{{ end -}}
// Code generated by archai plugin events gen. DO NOT EDIT.
//
// Component: {{ .Component }}
{{- if .Owns }}
// Owns:      {{ .Owns }}
{{- end }}
{{- if .Description }}
//
{{ docComment .Description }}
{{- end }}

package {{ $pkg }}

// Event kinds declared by this component. The constant is a Go name; the value
// is the wire name and is reproduced exactly as declared — a durable log is not
// refactorable.
const (
{{- range .Kinds }}
	Kind{{ goIdent . }} = {{ quote . }}
{{- end }}
)

// Emitted lists every kind this component appends to the log.
var Emitted = []string{
{{- range .Emits }}
	Kind{{ goIdent .Kind }}, // {{ .Role }}
{{- end }}
}

// Received lists every kind this component observes on its input port.
var Received = []string{
{{- range .Receives }}
	Kind{{ goIdent .Kind }}, // {{ .Role }}
{{- end }}
}
{{ if or .ForeignEmits .ForeignReceives }}
// Foreign kinds cross this component's namespace boundary: they are defined by
// somebody else's declaration, so their schemas are not this package's to change.
var Foreign = []string{
{{- range .ForeignEmits }}
	Kind{{ goIdent .Kind }}, // emitted
{{- end }}
{{- range .ForeignReceives }}
	Kind{{ goIdent .Kind }}, // received
{{- end }}
}
{{ end }}
{{- $exclusive := false }}{{ range .Emits }}{{ if .Exclusive }}{{ $exclusive = true }}{{ end }}{{ end }}
{{- range .Receives }}{{ if .Exclusive }}{{ $exclusive = true }}{{ end }}{{ end }}
{{- if $exclusive }}
// Exclusive kinds opted out of broadcast: exactly one component handles them.
var Exclusive = []string{
{{- range .Emits }}{{ if .Exclusive }}
	Kind{{ goIdent .Kind }},
{{- end }}{{ end }}
{{- range .Receives }}{{ if .Exclusive }}
	Kind{{ goIdent .Kind }},
{{- end }}{{ end }}
}
{{ end }}
{{- range .Folds }}
// Fold {{ .Name }}: one state per ({{ join .PartitionKey ", " }}).
{{- $f := goIdent .Name }}
const Fold{{ $f }}Name = {{ quote .Name }}

var (
	Fold{{ $f }}Subjects = []string{
	{{- range .Subjects }}
		{{ quote . }},
	{{- end }}
	}
	Fold{{ $f }}PartitionKey = []string{
	{{- range .PartitionKey }}
		{{ quote . }},
	{{- end }}
	}
	Fold{{ $f }}Consumes = []string{
	{{- range .Consumes }}
		{{ quote . }},
	{{- end }}
	}
)

// Fold{{ $f }}StateSchema is the declared projection state, as JSON Schema.
const Fold{{ $f }}StateSchema = {{ quote (jsonRaw .State) }}
{{ end }}
{{- range .Emits }}{{ if .Schema }}
// PayloadSchema{{ goIdent .Kind }} is the declared wire schema for {{ .Kind }}.
const PayloadSchema{{ goIdent .Kind }} = {{ quote (jsonRaw .Schema) }}
{{ end }}{{ end }}
{{- range .Types }}
// TypeSchema{{ goIdent .Name }} is the reusable definition {{ .Name }}.
const TypeSchema{{ goIdent .Name }} = {{ quote (jsonRaw .Schema) }}
{{ end }}
