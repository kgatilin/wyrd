# Task manager
.tm/

# Local worktrees
.worktrees/

# Binary
/wyrd
/bin/

# Per-worktree runtime state (M9): CURRENT pointer + serve.json record
# live here so parallel worktrees don't collide on ports or target ids.
.arch/.worktree/

# Runtime daemon locks (not part of the tracked model snapshot under .arch/).
.arch/*.lock

# Agent worktree checkouts created under .claude/ (embedded git repos).
.claude/worktrees/

# Local model cache used by wyrd serve.
.archai/

# Local go.work overrides (dev-only; not part of the PR contract)
go.work
go.work.sum

# Playwright CLI scratch output (local debugging only)
.playwright-cli/

# The .wyrd spec dir name is also accepted by readers; runtime junk there is ignored like .arch
.wyrd/.worktree/
.wyrd/*.lock
